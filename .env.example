# Luminara BTC — local/deployment configuration.
NODE_ENV=development
PORT=3000

# Dedicated database only. A deployed BTC service must not receive DATABASE_URL.
DATABASE_BOUNDARY_ID=luminara_btc
BTC_DATABASE_URL=

# Use independent random values of at least 32 characters in deployment.
BTC_JWT_SECRET=
BTC_REFRESH_SECRET=

# Dedicated bot created in BotFather.
BTC_TELEGRAM_BOT_TOKEN=
BTC_TELEGRAM_BOT_USERNAME=
BTC_TELEGRAM_APP_SLUG=atlas
BTC_SUPERADMIN_TG_IDS=

# Read-only Directus credential scoped to the approved BTC collections/rows.
DIRECTUS_URL=
DIRECTUS_TOKEN=

# Canonical public HTTPS hostname (host only, no protocol or path).
PUBLIC_HOST=localhost
CANONICAL_REDIRECT_ENABLED=false
CANONICAL_REDIRECT_HOSTS=
BTC_CORS_ORIGIN=

POLICY_VERSION=v1
PRIVATE_INDEXING_ENABLED=false
APP_VERSION=v0.1
